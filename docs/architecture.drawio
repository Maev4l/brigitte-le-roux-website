        <mxCell id="e17" value="SRP login (direct)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#C0392B;endArrow=classic;fontSize=10;" edge="1" parent="1" source="editor" target="cog-up">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → Cognito (JWT authorizer trusts the user pool) -->
        <mxCell id="e19" value="JWT authorizer&#xa;trusts pool" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#C0392B;endArrow=classic;dashed=1;fontSize=10;" edge="1" parent="1" source="api" target="cog-up">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- API → Lambdas (route invocations) -->
        <mxCell id="e21" value="ANY /api/git/{proxy+}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#D86613;endArrow=classic;fontSize=10;" edge="1" parent="1" source="api" target="lambda-gh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" value="GET /api/media/&#xa;s3-credentials" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#D86613;endArrow=classic;fontSize=10;" edge="1" parent="1" source="api" target="lambda-mm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

<!-- Lambda → SSM (read at cold start) -->
        <mxCell id="e28" value="GetParameter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#B0084D;endArrow=classic;fontSize=10;" edge="1" parent="1" source="lambda-gh" target="ssm-gh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e29" value="GetParameter" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#B0084D;endArrow=classic;fontSize=10;" edge="1" parent="1" source="lambda-mm" target="ssm-mm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda gh → GitHub API -->
        <mxCell id="e30" value="REST + GraphQL&#xa;(installation token)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#24292E;endArrow=classic;fontSize=10;" edge="1" parent="1" source="lambda-gh" target="ghapi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Lambda mm → editor (returns IAM creds) -->
        <mxCell id="e31" value="returns SSM creds&#xa;to OAuth shim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#D86613;endArrow=classic;dashed=1;fontSize=10;" edge="1" parent="1" source="lambda-mm" target="editor">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Editor → S3 (direct SigV4 PUT for media) -->
        <mxCell id="e32" value="PUT /data/* (SigV4)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#3F8624;endArrow=classic;fontSize=10;" edge="1" parent="1" source="editor" target="s3-bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- IAM user grants the direct PUT -->
        <mxCell id="e33" value="grants PutObject&#xa;on data/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#C0392B;endArrow=classic;fontSize=10;" edge="1" parent="1" source="iam-sveltia-user" target="s3-bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- IAM user creds stored in SSM -->
        <mxCell id="e35" value="access key + secret&#xa;stored in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#B0084D;endArrow=classic;dashed=1;fontSize=10;" edge="1" parent="1" source="iam-sveltia-user" target="ssm-mm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

<!-- GitHub Actions → OIDC → IAM role → S3 + CF -->
        <mxCell id="e40" value="AssumeRoleWith&#xa;WebIdentity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#24292E;endArrow=classic;fontSize=10;" edge="1" parent="1" source="gha" target="oidc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e41" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#C0392B;endArrow=classic;" edge="1" parent="1" source="oidc" target="iam-gha-role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e43" value="Get/Put/Delete&#xa;on bucket" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#3F8624;endArrow=classic;fontSize=10;" edge="1" parent="1" source="iam-gha-role" target="s3-bucket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e44" value="CreateInvalidation" style="edgeStyle=orthogonalEdgeStyle;rounded=1;labelBackgroundColor=none;html=1;strokeColor=#7D2BBD;endArrow=classic;fontSize=10;" edge="1" parent="1" source="iam-gha-role" target="cf-site">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
