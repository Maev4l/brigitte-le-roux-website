---
import '../styles/theme.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import frStrings from '../../content/i18n/fr.json';
import enStrings from '../../content/i18n/en.json';
import { identity } from '../lib/identity.mjs';
import { personSchema } from '../lib/schema.mjs';
import StructuredData from '../components/StructuredData.astro';

const { title, locale = 'fr', description, keywords, mainClass = 'container' } = Astro.props;

const strings = locale === 'en' ? enStrings : frStrings;
const fullTitle = `${title} — ${strings.site.title}`;
const metaDescription = description || strings.site.description;
const metaKeywords = keywords || strings.site.keywords;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogLocale = locale === 'en' ? 'en_US' : 'fr_FR';
const ogImage = new URL('/data/photoweb.jpg', Astro.site).href;

// Derive the logical slug (content-collection key) from the current pathname:
// strip the deploy base, strip the locale prefix, drop the trailing slash. The
// sentinel value `home` is used because the home page has no folder name in the
// URL but its content lives at `content/pages/home.<locale>.md`. Duplicated in
// src/components/LanguagePicker.astro by design — only two callers and the rules
// are tightly bound to this site's URL layout, so a shared helper would add a
// file without proportionate value. Keep the two copies in sync if changed.
const baseUrl = import.meta.env.BASE_URL;
const stripped = Astro.url.pathname.startsWith(baseUrl)
  ? Astro.url.pathname.slice(baseUrl.length)
  : Astro.url.pathname.replace(/^\//, '');
const slug = locale === 'fr'
  ? (stripped === '' ? 'home' : stripped.replace(/\/$/, ''))
  : (stripped.replace(/^en\/?/, '').replace(/\/$/, '') || 'home');

// Suppress hreflang for locales whose page doesn't exist (e.g. `bureau` is FR-only).
const allPages = import.meta.glob('../../content/pages/**/*.md', { eager: true });
const frExists = `../../content/pages/${slug}.fr.md` in allPages;
const enExists = `../../content/pages/${slug}.en.md` in allPages;

const frUrl = new URL(slug === 'home' ? '/' : `/${slug}/`, Astro.site).href;
const enUrl = new URL(slug === 'home' ? '/en/' : `/en/${slug}/`, Astro.site).href;

// Person JSON-LD is emitted on every page — the primary brand-authority signal
// for search engines. Site URL is trailing-slash-stripped to keep the
// structured data clean (Astro.site.href ends with `/`).
const personLd = personSchema(identity, Astro.site.href.replace(/\/$/, ''), locale);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="keywords" content={metaKeywords} />
  <meta name="author" content={strings.site.title} />
  <link rel="canonical" href={canonical} />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  {frExists && <link rel="alternate" hreflang="fr" href={frUrl} />}
  {enExists && <link rel="alternate" hreflang="en" href={enUrl} />}
  {frExists && <link rel="alternate" hreflang="x-default" href={frUrl} />}

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={ogLocale} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={strings.site.title} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="preload" href="/fonts/fraunces-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/fraunces-italic-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/bricolage-grotesque-variable.woff2" as="font" type="font/woff2" crossorigin />

  <StructuredData schema={personLd} />
</head>
<body>
  <Header locale={locale} />
  <main class={mainClass}>
    <slot />
  </main>
  <Footer locale={locale} />
</body>
</html>
