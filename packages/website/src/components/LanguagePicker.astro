---
import frStrings from '../../content/i18n/fr.json';
import enStrings from '../../content/i18n/en.json';

const { locale = 'fr' } = Astro.props;
const otherLabel = locale === 'fr' ? frStrings.footer.switchLang : enStrings.footer.switchLang;
const baseUrl = import.meta.env.BASE_URL; // always ends with '/'
const path = Astro.url.pathname;
// Strip the base prefix so we operate on logical paths (e.g. "en/livres" or "")
const stripped = path.startsWith(baseUrl) ? path.slice(baseUrl.length) : path.replace(/^\//, '');

const isFr = locale === 'fr';
const slug = isFr
  ? (stripped === '' ? 'home' : stripped.replace(/\/$/, ''))
  : (stripped.replace(/^en\/?/, '').replace(/\/$/, '') || 'home');
const otherLocale = isFr ? 'en' : 'fr';

// Suppress the link when no counterpart markdown exists (e.g. `bureau` is FR-only).
// The glob is resolved at build time, so this has no runtime cost.
const allPages = import.meta.glob('../../content/pages/**/*.md', { eager: true });
const counterpartExists = `../../content/pages/${slug}.${otherLocale}.md` in allPages;

let otherPath = null;
if (counterpartExists) {
  const otherStripped = isFr
    ? (slug === 'home' ? 'en/' : `en/${slug}/`)
    : (slug === 'home' ? '' : `${slug}/`);
  otherPath = `${baseUrl}${otherStripped}`;
}
---

{otherPath && (
  <span class="lang-picker">
    <a href={otherPath}>{otherLabel}</a>
  </span>
)}
